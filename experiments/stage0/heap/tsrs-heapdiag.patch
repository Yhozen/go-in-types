diff --git a/crates/tsrs_checker/src/heapdiag.rs b/crates/tsrs_checker/src/heapdiag.rs
new file mode 100644
index 0000000..35c72c5
--- /dev/null
+++ b/crates/tsrs_checker/src/heapdiag.rs
@@ -0,0 +1,95 @@
+//! go-in-types stage 0 diagnosis counters (`TSRS_HEAPDIAG=1`, printed on stderr at exit). Diagnosis only.
+//!
+//! Plain counters of the walks suspected of growing with a type-level heap, plus instantiations by the alias (or
+//! type kind) of the type instantiated and by the mapper kind (permissive / restrictive / other).
+use rustc_hash::FxHashMap;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("TSRS_HEAPDIAG").is_ok_and(|v| !v.is_empty() && v != "0"))
+}
+
+macro_rules! counters {
+    ($($name:ident),* $(,)?) => {
+        #[allow(non_camel_case_types)]
+        #[derive(Clone, Copy)]
+        #[repr(usize)]
+        pub enum C { $($name),* }
+        const NAMES: &[&str] = &[$(stringify!($name)),*];
+    };
+}
+counters!(
+    inst_total,
+    inst_permissive,
+    inst_restrictive,
+    permissive_calls,
+    permissive_misses,
+    restrictive_calls,
+    restrictive_misses,
+    could_contain_computed,
+    relation_key_worker,
+    relation_key_generic_visits,
+    infer_from_types,
+    infer_types_calls,
+    is_deeply_nested_calls,
+    is_type_related_calls,
+    is_type_related_identity_hits,
+    check_type_related_calls,
+    is_related_to_calls,
+    recursive_type_related_calls,
+    structured_type_related_calls,
+    type_reference_created,
+    type_reference_hits,
+    deferred_reference_created,
+    conditional_resolutions,
+    alias_instantiation_misses,
+    relation_size_max,
+);
+
+static COUNTS: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+
+#[inline]
+pub fn add(c: C, n: u64) {
+    if on() {
+        COUNTS[c as usize].fetch_add(n, Ordering::Relaxed);
+    }
+}
+
+#[inline]
+pub fn max(c: C, n: u64) {
+    if on() {
+        COUNTS[c as usize].fetch_max(n, Ordering::Relaxed);
+    }
+}
+
+static BY_ALIAS: Mutex<Option<FxHashMap<String, u64>>> = Mutex::new(None);
+
+/// One instantiation of a type known by `label` (its alias name, or its kind).
+pub fn inst_label(label: &str) {
+    let mut g = BY_ALIAS.lock().unwrap();
+    *g.get_or_insert_with(FxHashMap::default).entry(label.to_string()).or_insert(0) += 1;
+}
+
+pub fn dump() {
+    if !on() {
+        return;
+    }
+    eprintln!("== heapdiag counters");
+    for (i, n) in NAMES.iter().enumerate() {
+        eprintln!("heapdiag {:<32} {}", n, COUNTS[i].load(Ordering::Relaxed));
+    }
+    let g = BY_ALIAS.lock().unwrap();
+    if let Some(m) = g.as_ref() {
+        let mut rows: Vec<_> = m.iter().collect();
+        rows.sort_by(|a, b| b.1.cmp(a.1).then_with(|| a.0.cmp(b.0)));
+        let top: usize =
+            std::env::var("TSRS_HEAPDIAG_TOP").ok().and_then(|v| v.parse().ok()).unwrap_or(40);
+        eprintln!("== heapdiag instantiations by alias/kind ({} labels)", rows.len());
+        for (k, v) in rows.into_iter().take(top) {
+            eprintln!("heapdiag-inst {:<40} {}", k, v);
+        }
+    }
+}
