{
  "name": "go-in-types",
  "version": "0.0.0",
  "private": true,
  "description": "Go programs compiled to TypeScript type aliases and run by the type checker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vp test",
    "typecheck": "tsrs --noEmit --fast",
    "check": "vp check && tsrs --noEmit --fast",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
